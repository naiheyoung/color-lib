{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["dom", "esnext"],
    "allowJs": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true
  },
  "exclude": ["node_modules", "dist", "bin"]
}
